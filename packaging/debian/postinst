#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    # apply the Surface Dial access rule to an already connected Dial
    if command -v udevadm >/dev/null 2>&1 && [ -d /run/udev ]; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=hidraw --subsystem-match=input --action=change || true
    fi
fi
#DEBHELPER#
exit 0
