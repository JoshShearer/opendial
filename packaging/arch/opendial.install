post_install() {
  cat <<'MSG'
==> OpenDial: the udev rule gives the logged-in seat access to the Surface Dial.
    Reconnect the Dial (or run: udevadm trigger) so it applies, then per user:
      systemctl --user enable --now opendial.service
    and open "OpenDial" from the application menu.
MSG
}

post_upgrade() {
  echo '==> OpenDial: restart the service per user: systemctl --user restart opendial.service'
}
