[Unit]
Description=OpenDial Surface Dial service
Documentation=man:opendiald(1) https://github.com/JoshShearer/opendial
# Needs the graphical session (Wayland/X11 display, portals, session bus).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.joshshearer.opendial
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/opendiald
Restart=on-failure
RestartSec=2
# Unprivileged user service; device access comes from udev uaccess ACLs.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=graphical-session.target
