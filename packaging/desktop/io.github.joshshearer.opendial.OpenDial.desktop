[Desktop Entry]
Type=Application
Name=OpenDial
GenericName=Surface Dial Settings
Comment=Configure the Microsoft Surface Dial: radial menu, tools, app profiles and haptics
Exec=opendial %U
Icon=io.github.joshshearer.opendial.OpenDial
Terminal=false
Categories=Settings;HardwareSettings;Qt;
Keywords=surface;dial;radial;controller;knob;wheel;haptics;bluetooth;
StartupNotify=true
StartupWMClass=opendial
SingleMainWindow=true
